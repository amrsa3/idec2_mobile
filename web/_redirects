# Netlify redirects for Flutter Web App
# Handle client-side routing
/*    /index.html   200

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, PATCH, OPTIONS, HEAD
  Access-Control-Allow-Headers: Content-Type, Authorization, Accept, Origin, X-Requested-With, Cache-Control, Pragma, Expires, Last-Modified, If-Modified-Since, X-CSRF-Token
  Access-Control-Expose-Headers: Content-Type, Content-Disposition, Cache-Control, Content-Length, Date, ETag, Last-Modified, Authorization, X-Total-Count
  Access-Control-Allow-Credentials: true
  Access-Control-Max-Age: 86400
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https: http: ws: wss:;

# Cache control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache control for main files
/main.dart.js
  Cache-Control: public, max-age=31536000, immutable

# Cache control for manifest and service worker
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/flutter_service_worker.js
  Cache-Control: public, max-age=0, must-revalidate